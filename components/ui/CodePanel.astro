---
import { Code } from "astro:components";

import { codeThemes } from "../../code-themes";

interface Props {
  code: string;
  lang: string;
  filename?: string;
  class?: string;
}

const { code, lang, filename, class: className } = Astro.props;
---

<div class:list={["code-ink min-w-0 bg-code-surface", className]}>
  {
    filename && (
      <div class="border-b border-border px-5 py-3 font-mono text-xs text-dim">
        {filename}
      </div>
    )
  }
  <slot />
  <Code
    code={code.trim()}
    lang={lang as never}
    themes={codeThemes as never}
    defaultColor={false}
    class="m-0 overflow-x-auto px-7 py-6 font-mono text-sm/[1.9]"
  />
</div>
