---
interface Props {
  href: string;
  variant?: "accent" | "primary";
  size?: "md" | "lg";
  class?: string;
}

const { href, variant = "primary", size = "md", class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center gap-2 rounded-xl no-underline transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fp-green motion-reduce:transition-none motion-reduce:hover:translate-y-0",
    {
      "bg-fp-green text-fp-night": variant === "accent",
      "bg-primary text-primary-foreground": variant === "primary",
      "h-12 px-5 font-semibold": size === "md",
      "h-13 px-6 font-bold": size === "lg",
    },
    className,
  ]}
>
  <slot />
  <span aria-hidden="true">→</span>
</a>
