---
interface Props {
  html: string;
  /** Second line, set in the muted heading colour. */
  subtitle?: string;
  as?: "h1" | "h2";
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const { html, subtitle, as: Tag = "h2", size = "md", class: className } = Astro.props;
const sizes = {
  sm: "text-[clamp(1.75rem,3.4vw,2.5rem)]/[1.1] tracking-[-0.04em]",
  md: "text-[clamp(2rem,4.4vw,3.25rem)]/[1.08] tracking-[-0.04em]",
  lg: "text-[clamp(2.5rem,5.5vw,4rem)]/[1.05] tracking-[-0.045em]",
  xl: "text-[clamp(3rem,8vw,6rem)]/none tracking-[-0.045em]",
};
---

<div class:list={["flex flex-col", className]}>
  <Tag class:list={["m-0 font-display font-semibold text-balance text-heading", sizes[size]]} set:html={html} />
  {
    subtitle && (
      <p
        class:list={[
          "m-0 font-display font-semibold text-balance text-heading-muted",
          size === "xl" ? "mt-3.5 text-[clamp(2rem,5vw,3.5rem)]/[1.05] tracking-[-0.04em]" : ["mt-1.5", sizes[size]],
        ]}
        set:html={subtitle}
      />
    )
  }
</div>
