---
interface Props {
  invert?: boolean;
  id?: string;
  class?: string;
}

const { invert = false, id, class: className } = Astro.props;
---

<p
  id={id}
  class:list={[
    "m-0 text-sm font-semibold tracking-wide uppercase",
    invert ? "text-fp-green" : "text-highlight",
    className,
  ]}
>
  <slot />
</p>
