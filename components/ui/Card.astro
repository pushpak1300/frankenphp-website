---
interface Props {
  title: string;
  content: string;
  class?: string;
}

const { title, content, class: className } = Astro.props;
---

<li class:list={["bg-background p-6", className]}>
  <h3 class="m-0 text-[15px]/snug font-medium text-heading" set:html={title} />
  <p class="rich-text m-0 mt-1.5 text-sm/relaxed text-muted-foreground" set:html={content} />
</li>
