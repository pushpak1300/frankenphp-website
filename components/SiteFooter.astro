---
import { localeOfRoute, localizePath, stringsFor } from "./i18n";

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? localeOfRoute(Astro.url.pathname);
const t = stringsFor(locale);
const year = new Date().getFullYear();
const docs = (path = "") => localizePath(`/docs${path}`, locale);
const columns = [
  {
    title: "Product",
    links: [
      { label: t.nav.docs, href: docs() },
      { label: "Worker mode", href: docs("/worker") },
      { label: "Docker", href: docs("/docker") },
      { label: "Laravel", href: docs("/laravel") },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "GitHub", href: "https://github.com/php/frankenphp" },
      { label: t.nav.help, href: localizePath("/help", locale) },
      { label: t.nav.shop, href: "https://frankenphp.tpopsite.com/shop" },
    ],
  },
];
---

<footer class="mt-32 border-t border-border">
  <div class="mx-auto flex max-w-[75rem] flex-wrap justify-between gap-10 px-6 pt-14 pb-12">
    <div class="flex max-w-[460px] flex-[1_1_340px] flex-col gap-[18px]">
      <div class="flex items-center gap-3.5">
        <img src="/img/elephant_footer.svg" alt="" width="52" height="53" loading="lazy" decoding="async" class="block h-auto w-[52px]" />
        <img src="/img/logo_lightbg.svg" alt="FrankenPHP" width="136" height="18" loading="lazy" class="block h-[18px] w-auto dark:hidden" />
        <img src="/img/logo_darkbg.svg" alt="FrankenPHP" width="136" height="18" loading="lazy" class="hidden h-[18px] w-auto dark:block" />
      </div>
      <p class="rich-text m-0 text-sm/[1.7] text-muted-foreground">
        <Fragment set:html={t.footer.owner} />
        {" "}<Fragment set:html={t.footer.design} />
        {" "}<Fragment set:html={t.footer.sponsor} />
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-14">
      {
        columns.map((column) => (
          <div class="flex flex-col gap-2.5 text-sm">
            <span class="font-mono text-[11px] font-medium tracking-[0.12em] text-dim uppercase">{column.title}</span>
            {column.links.map((link) => (
              <a class="text-muted-foreground no-underline transition-colors hover:text-heading" href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
  </div>
  <div class="mx-auto flex max-w-[75rem] flex-wrap justify-between gap-3 border-t border-border px-6 pt-5 pb-8 font-mono text-xs text-dim">
    <span>© {year} FrankenPHP · MIT License</span>
    <span>Built on Caddy · Written in Go</span>
  </div>
</footer>
