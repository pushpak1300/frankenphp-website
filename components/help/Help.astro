---
import CustomPage from "../CustomPage.astro";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Heading from "../ui/Heading.astro";
import { stringsFor } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
const help = t.help;
const contact = "mailto:contact@les-tilleuls.coop";

const blocks = [
  { ...help.migration, href: contact, image: "/img/migration.svg", width: 474, height: 553 },
  { ...help.hosting, href: "https://les-tilleuls.coop/en/cloud-security", image: "/img/bellboy.svg", width: 1540, height: 1361 },
  { ...help.services, href: "https://les-tilleuls.coop/en", image: "/img/love_php.svg", width: 1266, height: 976 },
];
const description = help.hero.content.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 158);
---

<CustomPage locale={locale} path="/help" title={`${t.nav.help} — FrankenPHP`} description={description}>
  <section class="bg-dots relative overflow-hidden border-b border-border">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_70%_at_50%_30%,transparent_20%,var(--blume-background)_80%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_0%,var(--fp-haze),transparent_70%)]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[75rem] items-center gap-12 px-6 py-20 md:py-28 lg:grid-cols-5">
      <div class="flex min-w-0 flex-col items-start gap-6 lg:col-span-3">
        <Eyebrow>{help.hero.overtitle}</Eyebrow>
        <Heading as="h1" size="lg" html={help.hero.title} />
        <p class="rich-text m-0 max-w-xl text-[19px]/[1.6] text-muted-foreground" set:html={help.hero.content} />
        <Button href={contact} size="lg">{help.hero.button}</Button>
      </div>
      <img src="/img/franken-heart.svg" alt="" width="320" height="343" fetchpriority="high" class="mx-auto h-auto w-full max-w-xs lg:col-span-2" />
    </div>
  </section>

  <div class="mx-auto flex max-w-[75rem] flex-col gap-28 px-6 pt-24">
    {
      blocks.map((block, i) => (
        <section class="grid items-center gap-12 md:grid-cols-5">
          <div class="flex min-w-0 flex-col items-start gap-6 md:col-span-3">
            <Heading html={block.title} />
            <p class="rich-text m-0 text-base/relaxed text-muted-foreground" set:html={block.content} />
            <Button href={block.href}>{block.button}</Button>
          </div>
          <img
            src={block.image}
            alt=""
            width={block.width}
            height={block.height}
            loading="lazy"
            decoding="async"
            class:list={["mx-auto h-auto max-h-80 w-full max-w-xs object-contain md:col-span-2", i % 2 === 1 && "md:order-first"]}
          />
        </section>
      ))
    }

    <section class="grid items-center gap-10 rounded-2xl border border-border bg-surface-tint p-8 md:grid-cols-5 md:p-12">
      <div class="flex min-w-0 flex-col gap-5 md:col-span-3">
        <Heading html={help.go.title} />
        <p class="rich-text m-0 text-base/relaxed text-muted-foreground" set:html={help.go.content} />
      </div>
      <img src="/img/gokenstein.svg" alt="" width="1881" height="1510" loading="lazy" decoding="async" class="mx-auto h-auto w-full max-w-xs md:col-span-2" />
    </section>

    <section class="@container">
      <Heading html={help.further.title} />
      <p class="m-0 mt-3 mb-9 text-lg text-muted-foreground">{help.further.subtitle}</p>
      <ul class="m-0 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0 @xl:grid-cols-2 @4xl:grid-cols-3">
        {help.further.content.map((item) => <Card title={item.title} content={item.content} />)}
      </ul>
    </section>
  </div>
</CustomPage>
