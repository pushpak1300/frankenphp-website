---
// Above every translated docs page: the community-translation notice, linking
// to the English reference version of the same page.
import { DEFAULT_LOCALE, localeOfRoute, stringsFor, unlocalizedRoute } from "./i18n";

interface Props {
  route?: string;
}

const route = Astro.props.route ?? Astro.url.pathname;
const locale = localeOfRoute(route);
const notice =
  locale === DEFAULT_LOCALE
    ? null
    : stringsFor(locale).notice.replace(
        /<strong>(.*?)<\/strong>/,
        `<a href="${unlocalizedRoute(route)}" hreflang="en">$1</a>`
      );
---

{
  notice && (
    <aside class="fp-translation-notice not-prose" data-pagefind-ignore>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6" />
      </svg>
      <p set:html={notice} />
    </aside>
  )
}
