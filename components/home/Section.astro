---
import Eyebrow from "../ui/Eyebrow.astro";
import Heading from "../ui/Heading.astro";

interface Props {
  overtitle?: string;
  title: string;
  subtitle?: string;
  href?: string;
  hrefLabel?: string;
}

const { overtitle, title, subtitle, href, hrefLabel } = Astro.props;
---

<section class="mx-auto max-w-[75rem] px-6 pt-32">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
    <div class="min-w-0">
      {overtitle && <Eyebrow class="mb-4">{overtitle}</Eyebrow>}
      <Heading html={title} subtitle={subtitle} />
    </div>
    {
      href && (
        <a href={href} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-heading no-underline hover:underline">
          {hrefLabel} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  <div class="@container">
    <slot />
  </div>
</section>
