---
import Eyebrow from "../ui/Eyebrow.astro";
import Heading from "../ui/Heading.astro";

interface Props {
  overtitle?: string;
  title: string;
  lead?: string;
  href?: string;
  hrefLabel?: string;
  big?: boolean;
}

const { overtitle, title, lead, href, hrefLabel, big = false } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 pt-24 pb-4 md:pt-28">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
    <div class="flex max-w-2xl min-w-0 flex-col gap-3.5">
      {overtitle && <Eyebrow>{overtitle}</Eyebrow>}
      <Heading html={title} size={big ? "lg" : "md"} />
      {lead && <p class="rich-text m-0 mt-1 max-w-xl text-lg/relaxed text-muted-foreground" set:html={lead} />}
    </div>
    {
      href && (
        <a href={href} class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-link no-underline hover:underline">
          {hrefLabel} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  <div class="@container">
    <slot />
  </div>
</section>
