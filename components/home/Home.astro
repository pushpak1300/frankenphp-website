---
import CustomPage from "../CustomPage.astro";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import CodePanel from "../ui/CodePanel.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Heading from "../ui/Heading.astro";
import CopyButton from "./CopyButton.astro";
import FeatureArt from "./FeatureArt.astro";
import Section from "./Section.astro";
import { localizePath, stringsFor } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
const en = stringsFor("en").home;
const home = t.home;
const docs = (path = "") => localizePath(`/docs${path}`, locale);

// Copy added with the redesign is English-only for now; translated locales keep
// their own strings and fall back to English only for the sections they lack.
type Extra = { subtitle?: string; cta?: string; tagline?: string; pill?: string };
const extra = (section: object): Extra => section as Extra;

const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const plainTitle = home.hero.title.replace(/<[^>]+>/g, "").trim();
let heroTitle = escape(plainTitle);
let heroTagline = extra(home.hero).tagline;
if (!heroTagline) {
  const comma = Math.max(plainTitle.lastIndexOf(","), plainTitle.lastIndexOf("，"), plainTitle.lastIndexOf("、"));
  if (comma !== -1) {
    heroTitle = escape(plainTitle.slice(0, comma + 1));
    heroTagline = escape(plainTitle.slice(comma + 1).trim());
  }
}
const heroSubtitle = extra(home.hero).subtitle ?? t.meta.description;
const pill = extra(home.hero).pill;
const bento = (home as { bento?: typeof en.bento }).bento ?? en.bento;
const helpCta = (home as { helpCta?: typeof en.helpCta }).helpCta ?? {
  overtitle: t.help.hero.overtitle,
  title: t.help.hero.title,
  content: "",
  button: t.nav.help,
};

const installCommand = "curl https://frankenphp.dev/install.sh | sh";

const workerScript = `<?php
// Boot your app once
require __DIR__.'/vendor/autoload.php';

$app = new \\App\\Kernel();
$app->boot();

$handler = static function () use ($app) {
    echo $app->handle($_GET, $_POST, $_COOKIE, $_FILES, $_SERVER);
};

while (\\frankenphp_handle_request($handler)) {
    gc_collect_cycles();
}`;

const tabs = [
  { id: "system", label: home.gettingStarted.staticTab, code: home.gettingStarted.standard },
  { id: "docker", label: home.gettingStarted.dockerTab, code: home.gettingStarted.docker },
];
const chips = ["HTTPS", "HTTP/2", "HTTP/3", "zstd", "Brotli", "gzip", "Early Hints"];
const check =
  '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>';
---

<CustomPage locale={locale} path="/" title={t.meta.title} description={t.meta.description}>
  <section class="bg-dots relative overflow-hidden border-b border-border">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_55%_at_50%_30%,transparent_20%,var(--blume-background)_78%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_0%,var(--fp-haze),transparent_70%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-[58%] left-1/2 size-[760px] max-w-[120%] -translate-1/2 rounded-full bg-[radial-gradient(closest-side,var(--fp-glow),transparent)] blur-[30px]" aria-hidden="true"></div>
    <div class="relative mx-auto flex max-w-[62.5rem] flex-col items-center px-6 pt-24 text-center">
      {pill && (
      <a
        href="https://github.com/php/frankenphp"
        class="inline-flex min-h-9 items-center gap-2.5 rounded-full border border-line bg-surface-tint px-3.5 font-mono text-xs text-muted-foreground no-underline transition-colors hover:text-heading"
      >
        <span class="size-1.5 rounded-full bg-fp-green"></span>
        {pill}
        <span aria-hidden="true">→</span>
      </a>
      )}
      <Heading as="h1" size="xl" html={heroTitle} subtitle={heroTagline} class="mt-8 items-center" />
      <p class="m-0 mt-7 max-w-[40rem] text-[19px]/[1.6] text-muted-foreground">{heroSubtitle}</p>
      <div class="mt-9 flex w-full flex-wrap items-center justify-center gap-3">
        <div class="flex h-12 max-w-full min-w-0 items-center gap-2.5 rounded-full border border-line-strong bg-surface-tint ps-5 pe-1.5 font-mono text-sm">
          <span class="text-dim" aria-hidden="true">$</span>
          <code class="min-w-0 truncate text-heading">{installCommand}</code>
          <CopyButton text={installCommand} label={t.ui.copy} copied={t.ui.copied} />
        </div>
        <Button href={docs()} size="lg">{home.hero.cta}</Button>
      </div>
      <img
        src="/img/elephant_cover.svg"
        alt="The FrankenPHP elephant mascot"
        width="420"
        height="406"
        fetchpriority="high"
        class="relative mt-16 -mb-7 block h-auto w-full max-w-[420px]"
      />
    </div>
  </section>

  <section class="mx-auto max-w-[75rem] px-6 py-14 text-center" aria-labelledby="technos-title">
    <Eyebrow id="technos-title" class="mb-7">{home.technos.title}</Eyebrow>
    <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-12 gap-y-4 p-0">
      {
        home.technos.items.map((item) => (
          <li>
            <a href={item.url} class="flex h-10 items-center opacity-55 brightness-0 transition-opacity hover:opacity-100 dark:opacity-60 dark:invert dark:hover:opacity-100">
              <img src={item.image} alt={item.title} width="100" height="40" loading="lazy" decoding="async" class="h-10 w-auto" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[75rem] px-6 pt-[4.5rem]">
    <Eyebrow class="mb-4">{bento.overtitle}</Eyebrow>
    <Heading html={bento.title} subtitle={bento.subtitle} class="mb-12" />
    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-px overflow-hidden rounded-2xl border border-border bg-border p-0">
      {
        bento.items.map((item) => (
          <li class="bg-background">
            <a
              href={localizePath(item.href, locale)}
              class="group flex h-full min-h-[380px] flex-col px-8 pt-8 text-inherit no-underline transition-colors hover:bg-surface-tint"
            >
              <h3 class="m-0 flex items-center justify-between text-xl font-medium tracking-[-0.02em] text-heading">
                {item.title}
                <span aria-hidden="true" class="text-base text-dim opacity-0 transition-opacity group-hover:opacity-100">→</span>
              </h3>
              <p class="m-0 mt-2.5 text-[15px]/[1.6] text-muted-foreground">{item.content}</p>
              <FeatureArt id={item.id} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Section overtitle={home.gettingStarted.overtitle} title={home.gettingStarted.title} subtitle={extra(home.gettingStarted).subtitle}>
    <div class="overflow-hidden rounded-2xl border border-border bg-code-surface" data-fp-tabs>
      <div role="tablist" aria-label={home.gettingStarted.overtitle} class="flex gap-1 border-b border-border px-2 pt-2">
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`fp-tab-${tab.id}`}
              aria-controls={`fp-panel-${tab.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="min-h-11 cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-4 font-mono text-[13px] text-dim transition-colors hover:text-heading aria-selected:border-accent-ink aria-selected:text-heading"
            >
              {tab.label}
            </button>
          ))
        }
      </div>
      {
        tabs.map((tab, i) => (
          <div role="tabpanel" id={`fp-panel-${tab.id}`} aria-labelledby={`fp-tab-${tab.id}`} hidden={i !== 0}>
            <CodePanel code={tab.code} lang="bash" class="relative">
              <div class="absolute end-3 top-3">
                <CopyButton text={tab.code.replace(/^#.*\n/gm, "").trim()} label={t.ui.copy} copied={t.ui.copied} />
              </div>
            </CodePanel>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    overtitle={home.config.overtitle}
    title={home.config.title}
    subtitle={extra(home.config).subtitle}
    href={docs("/config")}
    hrefLabel={`${extra(home.config).cta ?? t.nav.docs}`}
  >
    <div class="flex flex-wrap overflow-hidden rounded-2xl border border-border">
      <CodePanel code={home.config.code} lang="caddyfile" filename="Caddyfile" class="flex-[3_1_420px]" />
      <div class="flex flex-[2_1_320px] flex-col justify-center gap-6 border-l border-border p-9">
        <p class="rich-text m-0 text-base/[1.7] text-muted-foreground" set:html={home.config.content} />
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0 font-mono text-xs text-muted-foreground">
          {chips.map((chip) => <li class="rounded-full border border-line px-3 py-1">{chip}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section
    overtitle={home.worker.overtitle}
    title={home.worker.title}
    subtitle={extra(home.worker).subtitle}
    href={docs("/worker")}
    hrefLabel={`${extra(home.worker).cta ?? t.nav.docs}`}
  >
    <div class="flex flex-wrap overflow-hidden rounded-2xl border border-border">
      <CodePanel code={workerScript} lang="php" filename="public/index.php" class="flex-[3_1_460px]" />
      <div class="bg-dots flex flex-[2_1_320px] items-center justify-center border-l border-border p-10">
        <img src="/img/worker2.svg" alt="The FrankenPHP mascot running several workers" width="360" height="281" loading="lazy" decoding="async" class="block h-auto w-full max-w-[360px]" />
      </div>
    </div>
    <ul class="m-0 mt-4 grid list-none grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-px overflow-hidden rounded-2xl border border-border bg-border p-0">
      {home.worker.items.map((item) => <Card title={item.title} content={item.content} />)}
    </ul>
  </Section>

  <section class="mx-auto max-w-[75rem] px-6 pt-32">
    <div class="bg-dots flex flex-wrap items-center gap-10 rounded-2xl border border-border p-[clamp(28px,5vw,56px)]">
      <div class="min-w-0 flex-[3_1_440px]">
        <Eyebrow class="mb-4">{home.modern.overtitle}</Eyebrow>
        <Heading html={home.modern.title} subtitle={extra(home.modern).subtitle} size="sm" class="mb-8" />
        <ul class="m-0 mb-9 flex list-none flex-col gap-3.5 p-0 text-[15px]/[1.6] text-muted-foreground">
          {
            home.modern.items.map((item) => (
              <li class="flex gap-3.5">
                <span class="mt-0.5 flex size-5 flex-none items-center justify-center rounded-full border border-accent-ink text-accent-ink" aria-hidden="true" set:html={check} />
                <span class="rich-text" set:html={item} />
              </li>
            ))
          }
        </ul>
        <Button href={docs()} variant="invert">{home.modern.cta}</Button>
      </div>
      <img src="/img/dab.svg" alt="The FrankenPHP mascot dabbing" width="320" height="356" loading="lazy" decoding="async" class="mx-auto block h-auto w-full max-w-[320px] flex-[2_1_260px]" />
    </div>
  </section>

  <section class="mx-auto max-w-[75rem] px-6 pt-4">
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-7 rounded-2xl border border-border bg-surface-tint p-[clamp(28px,5vw,56px)]">
      <div class="max-w-[620px]">
        <Eyebrow class="mb-4">{helpCta.overtitle}</Eyebrow>
        <Heading html={helpCta.title} size="sm" />
        {helpCta.content && <p class="m-0 mt-3.5 text-base/[1.6] text-muted-foreground">{helpCta.content}</p>}
      </div>
      <Button href={localizePath("/help", locale)} size="lg">{helpCta.button}</Button>
    </div>
  </section>
</CustomPage>

<script>
  function initTabs() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-fp-tabs]")) {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (tab: HTMLButtonElement) => {
        for (const other of tabs) {
          const selected = other === tab;
          other.setAttribute("aria-selected", String(selected));
          other.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(other.getAttribute("aria-controls") ?? "");
          if (panel) panel.hidden = !selected;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (event) => {
          const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
    }
  }
  document.addEventListener("astro:page-load", initTabs);
</script>
